{
  "name": "url_prefix_denylist fires when terms_url starts with a denied prefix",
  "policy": {
    "version": "fx-upd",
    "rules": [
      {
        "id": "upd",
        "type": "url_prefix_denylist",
        "outcome": "deny",
        "parameters": {"denied": ["https://evil.example/"]}
      }
    ]
