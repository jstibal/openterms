    "action_context": {"target": "ssn-987-65-4321"}
  },
  "expected": {
    "decision": "deny",
    "triggered_rules": ["apm"],
    "reasons": ["ARGS_PATTERN_MATCH: pattern at action_context.target matched value 'ssn-*'"]
  }
