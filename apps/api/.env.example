# Postgres connection string. Database must exist; run migrations once before first boot.
DATABASE_URL=postgres://localhost:5432/openterms

# JWKS source. Schemes:
#   file:<path>      Load and re-read on every request (fine for tests, dev)
#   memory:<json>    Inline JWKS as URL-encoded JSON (tests only)
JWKS_SOURCE=file:./jwks.local.json

# Workspace this service instance is bound to. Receipts whose workspace_id does
# not match are rejected with VALIDATION_ERROR.
WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# HTTP listen port.
PORT=8080

# Pino log level.
LOG_LEVEL=info
